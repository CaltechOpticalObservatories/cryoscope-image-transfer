#!/bin/bash
#
# role -- switch a concordia between active and spare.
#
#     role              report the current role
#     role active       become the data computer
#     role spare        become the cold spare
#
# Failover is manual. There is no automatic promotion, no heartbeat and no
# quorum. This command performs the whole transition in one step.

set -u

CONFDIR=/etc/cryoscope
CONFFILE=site.conf
ROLE_FILE=$CONFDIR/role

# Units that define the active data computer.
ACTIVE_UNITS="pull-images trigger-pull nginx arrival-hash"

say()  { printf '%s\n' "$*"; }
ok()   { printf '   ok       %s\n' "$*"; }
note() { printf '   note     %s\n' "$*"; }
warn() { printf '   WARNING  %s\n' "$*"; }
die()  { printf 'role: %s\n' "$*" >&2; exit 1; }

unit_exists() {
    # list-unit-files matches full unit names only.
    local u=$1
    case "$u" in *.*) ;; *) u="$u.service" ;; esac
    systemctl list-unit-files "$u" --no-legend 2>/dev/null | grep -q .
}

enable_unit() {
    unit_exists "$1" || { note "$1 not installed yet, skipped"; return 0; }
    sudo systemctl enable --now "$1" >/dev/null 2>&1 \
        && ok "$1 enabled and running" \
        || warn "$1 did not start. systemctl status $1"
}

disable_unit() {
    unit_exists "$1" || return 0
    sudo systemctl disable --now "$1" >/dev/null 2>&1 \
        && ok "$1 disabled and stopped" \
        || warn "$1 could not be disabled"
}

# The hourly backstop is a crontab line, not a unit, and belongs to the active
# role. On a spare it would rsync from cryocontrol every hour; the cold spare
# takes nothing until it is made active.
#
# Disabling comments the line rather than deleting it, so the installed command
# survives a demotion and promotion unchanged.
cron_backstop() {
    local want=$1 cur new
    cur=$(crontab -l 2>/dev/null)
    case "$cur" in
        *pull-images-cron*) ;;
        *) note "no hourly backstop in the crontab; run setup.sh"; return 0 ;;
    esac
    if [ "$want" = on ]; then
        new=$(printf '%s\n' "$cur" | sed 's/^#SPARE //')
    else
        new=$(printf '%s\n' "$cur" | sed '/pull-images-cron/{/^#SPARE /!s/^/#SPARE /}')
    fi
    if [ "$new" = "$cur" ]; then
        ok "hourly backstop already ${want}"
    else
        printf '%s\n' "$new" | crontab - \
            && ok "hourly backstop turned ${want}" \
            || warn "could not rewrite the crontab"
    fi
}

[ "$(id -u)" -ne 0 ] || die "run this as the account 'user', not as root."
sudo -n true 2>/dev/null || sudo true || die "user needs sudo rights."

[ -f "$CONFDIR/$CONFFILE" ] || die "no $CONFDIR/$CONFFILE. Run setup.sh first."
[ -f "$CONFDIR/machine.conf" ] || die "no $CONFDIR/machine.conf. Run setup.sh first."
# shellcheck source=/dev/null
. "$CONFDIR/$CONFFILE"
# shellcheck source=/dev/null
. "$CONFDIR/machine.conf"
[ "${MACHINE_ROLE:-}" = data ] \
    || die "this is not a data computer. role applies to concordia1 and concordia2 only."

# ------------------------------------------------------------------ report --

if [ $# -eq 0 ]; then
    CUR=$(cat "$ROLE_FILE" 2>/dev/null || echo unknown)
    say "role: $CUR on $(hostname)"
    say ""
    for u in $ACTIVE_UNITS; do
        unit_exists "$u" || continue
        printf '   %-20s %-9s %s\n' "$u" \
            "$(systemctl is-enabled "$u" 2>/dev/null)" \
            "$(systemctl is-active "$u" 2>/dev/null)"
    done
    if crontab -l 2>/dev/null | grep -q 'pull-images-cron'; then
        crontab -l 2>/dev/null | grep -q '^#SPARE .*pull-images-cron' \
            && printf '   %-20s %-9s %s\n' "hourly backstop" "disabled" "inactive" \
            || printf '   %-20s %-9s %s\n' "hourly backstop" "enabled" "active"
    fi
    exit 0
fi

WANT=$1
shift
[ $# -eq 0 ] || die "unknown argument '$1'"

# ------------------------------------------------------------------ active --

case "$WANT" in
active)
    say "Becoming the ACTIVE data computer on $(hostname)."
    say ""

    # Single emitter rule. Two active machines double the read load on
    # cryocontrol and duplicate every IMAGE_AVAILABLE datagram. nginx runs on
    # the active machine only, and each concordia's firewall admits the other
    # on HTTP_PORT. Advisory only: the other machine may legitimately be dead.
    case "$(hostname)" in
        concordia1) OTHER=concordia2; OTHER_IP=$CONCORDIA2_IP ;;
        concordia2) OTHER=concordia1; OTHER_IP=$CONCORDIA1_IP ;;
        *) OTHER="" ;;
    esac
    if [ -n "$OTHER" ]; then
        if curl -s -o /dev/null --connect-timeout 3 -m 5 "http://$OTHER_IP:$HTTP_PORT/" 2>/dev/null; then
            warn "$OTHER answers on port $HTTP_PORT, so it is still active. Run
            'role spare' there, or power it off, before relying on this machine."
        else
            ok "$OTHER does not answer on port $HTTP_PORT: spare or off"
        fi
    fi

    for u in $ACTIVE_UNITS; do enable_unit "$u"; done
    cron_backstop on

    echo active | sudo tee "$ROLE_FILE" >/dev/null
    say ""
    ok "role is now active"
    say ""
    say "   Remaining manual step: the 30 second reconciliation sweep on"
    say "   cryostep is pinned to a configured address and cannot follow a"
    say "   failover. Change it by hand to http://$(hostname):$HTTP_PORT/."
    say "   Notified fetches follow automatically; IMAGE_AVAILABLE carries a URL."
    say ""
    say "   Then run: check.sh"
    ;;

# ------------------------------------------------------------------- spare --

spare)
    say "Becoming the SPARE on $(hostname)."
    say ""

    for u in $ACTIVE_UNITS; do disable_unit "$u"; done
    cron_backstop off

    echo spare | sudo tee "$ROLE_FILE" >/dev/null
    say ""
    ok "role is now spare"
    note "the full stack is still installed here; only the unit states differ."
    ;;

*)
    die "usage: role [active|spare]"
    ;;
esac

exit 0
